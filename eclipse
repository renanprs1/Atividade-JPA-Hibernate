package br.edu.exemplo.controller;
import java.math.BigDecimal;
import java.util.List;
import br.edu.exemplo.dao.ProdutoDAO;
import br.edu.exemplo.model.Produto;
public class ProdutoController {
private final ProdutoDAO dao=new ProdutoDAO();
private void validar(String nome,Integer qtd,BigDecimal valor){
if(nome==null||nome.isBlank()||nome.trim().length()&gt;120)
throw new IllegalArgumentException(&quot;Nome obrigatorio (maximo 120 caracteres).&quot;);
if(qtd==null||qtd&lt;0)throw new IllegalArgumentException(&quot;Quantidade invalida.&quot;);
if(valor==null||valor.signum()&lt;=0||valor.scale()&gt;2||
valor.precision()-valor.scale()&gt;10)
throw new IllegalArgumentException(&quot;Valor unitario invalido.&quot;);
}
private void validarId(Long id){
if(id==null||id&lt;=0)throw new IllegalArgumentException(&quot;ID invalido.&quot;);
}
public void cadastrar(String nome,Integer qtd,BigDecimal valor){
validar(nome,qtd,valor);dao.salvar(new Produto(nome.trim(),qtd,valor));
}
public List&lt;Produto&gt; listar(){return dao.listarTodos();}
public Produto consultar(Long id){validarId(id);return dao.buscarPorId(id);}
public boolean alterar(Long id,String nome,Integer qtd,BigDecimal valor){
validarId(id);validar(nome,qtd,valor);
Produto p=dao.buscarPorId(id);if(p==null)return false;
p.setNome(nome.trim());p.setQuantidade(qtd);p.setValorUnitario(valor);
dao.atualizar(p);return true;
}
public boolean excluir(Long id){validarId(id);return dao.excluir(id);}
}

package br.edu.exemplo.dao;
import java.util.List;
import br.edu.exemplo.model.Produto;
import br.edu.exemplo.util.JPAUtil;
import jakarta.persistence.*;
public class ProdutoDAO {
public void salvar(Produto p){
EntityManager em=JPAUtil.getEntityManager(); EntityTransaction tx=em.getTransaction();
try {tx.begin(); em.persist(p); tx.commit();}
catch(RuntimeException e){if(tx.isActive())tx.rollback();throw e;}
finally{em.close();}
}
public List&lt;Produto&gt; listarTodos(){
EntityManager em=JPAUtil.getEntityManager();
try{return em.createQuery(&quot;SELECT p FROM Produto p ORDER BY
p.id&quot;,Produto.class).getResultList();}
finally{em.close();}
}
public Produto buscarPorId(Long id){
EntityManager em=JPAUtil.getEntityManager();
try{return em.find(Produto.class,id);}finally{em.close();}
}
public void atualizar(Produto p){
EntityManager em=JPAUtil.getEntityManager(); EntityTransaction tx=em.getTransaction();
try{tx.begin();em.merge(p);tx.commit();}
catch(RuntimeException e){if(tx.isActive())tx.rollback();throw e;}
finally{em.close();}
}
public boolean excluir(Long id){
EntityManager em=JPAUtil.getEntityManager(); EntityTransaction tx=em.getTransaction();
try{tx.begin();Produto p=em.find(Produto.class,id);
if(p==null){tx.rollback();return false;}
em.remove(p);tx.commit();return true;
}catch(RuntimeException e){if(tx.isActive())tx.rollback();throw e;}
finally{em.close();}
}

