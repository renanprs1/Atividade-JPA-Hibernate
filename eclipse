package br.edu.exemplo.view;
import java.math.BigDecimal;
import java.util.Scanner;
import br.edu.exemplo.controller.ProdutoController;
import br.edu.exemplo.model.Produto;
public class ProdutoView {
private final ProdutoController controller=new ProdutoController();
private final Scanner sc=new Scanner(System.in);
private String ler(String msg){System.out.print(msg);return sc.nextLine().trim();}
private int inteiro(String msg){
while(true){try{return Integer.parseInt(ler(msg));}
catch(NumberFormatException e){System.out.println(&quot;Digite um inteiro valido.&quot;);}}
}
private long longo(String msg){
while(true){try{return Long.parseLong(ler(msg));}
catch(NumberFormatException e){System.out.println(&quot;Digite um ID valido.&quot;);}}

